# Streamlit Secrets Configuration - Invoice Pipeline
# LOCAL DEVELOPMENT ONLY - NOT IN GIT
#
# USAGE: Copy this file to secrets.toml and fill in your values
#        cp secrets.toml.example secrets.toml
#
# CRITICAL: Never commit secrets.toml to git!

# ============================================================
# GOOGLE OPENID CONNECT (OAuth 2.0 sign-in)
# ============================================================
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"

[auth.google]
client_id = "REPLACE_WITH_GOOGLE_WEB_CLIENT_ID"
client_secret = "REPLACE_WITH_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Each approved email maps to a DISTINCT existing database users.id.
# Reviewers retain the existing portal's admin capabilities.
[access.reviewers]
"reviewer@example.com" = 1

# ============================================================
# DATABASE CONNECTION
# ============================================================
[database]
host = "your-rds-endpoint.us-east-1.rds.amazonaws.com"
port = 5432
user = "postgres"
password = "YourRandomPassword123!"
database = "invoices"

# ============================================================
# AWS CONFIGURATION
# ============================================================
[aws]
region = "us-east-1"
s3_bucket = "your-invoice-bucket"
s3_prefix = "invoices/"

# ============================================================
# TEXTRACT SETTINGS
# ============================================================
[textract]
max_retries = 3
timeout_seconds = 300
